# Copiá a ".env" y ajustá lo que necesites. Todo tiene default salvo, si usás
# el backend "gemini" o el comando `ask`/`digest`, la API key.

# --- Indice y config ---
# KB_DB_PATH=~/.local/share/kb/index.db
# KB_CONFIG_PATH=kb.toml
# KB_DIGEST_OUT_DIR=digests

# --- Embeddings: "local" (offline, sin costo) o "gemini" (API) ---
EMBEDDINGS_BACKEND=local
# EMBED_MODEL_LOCAL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBED_MODEL_GEMINI=text-embedding-004

# --- Generación de respuestas (solo `ask` / `digest`) ---
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_MAX_OUTPUT_TOKENS=900
